# ============================================================
# G File Studio - Git ignore policy
# ============================================================

# ------------------------------------------------------------
# Python virtual environments
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------
# Python bytecode and caches
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.cache/

# ------------------------------------------------------------
# Test and coverage output
# ------------------------------------------------------------
.coverage
.coverage.*
htmlcov/
coverage.xml
pytest-report.xml

# ------------------------------------------------------------
# Packaging / PyInstaller output
# build_exe.ps1 generates build/, dist/ and release/ locally.
# They are deliverables/runtime artifacts, not source code.
# ------------------------------------------------------------
build/
dist/
release/
releases/
*.spec
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# ------------------------------------------------------------
# IDE and editor files
# ------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------
# Operating-system files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Logs, temporary files and backup files
# ------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
~$*
*.g.tmp
*.tmp.g

# ------------------------------------------------------------
# G File Studio runtime workspace
# IMPORTANT: workspace/runs/ may contain very large generated HTML/Excel
# reports (100 MB+). Never commit it to Git.
# ------------------------------------------------------------
workspace/runs/
workspace/temp/
workspace/tmp/
workspace/cache/
workspace/downloads/

# Legacy/other managed runtime folders. Preserve optional .gitkeep only.
workspace/input/*
!workspace/input/.gitkeep

workspace/processed/*
!workspace/processed/.gitkeep

workspace/merged/*
!workspace/merged/.gitkeep

workspace/adjusted/*
!workspace/adjusted/.gitkeep

workspace/work/**
!workspace/work/.gitkeep

workspace/output/*
!workspace/output/.gitkeep

workspace/logs/*
!workspace/logs/.gitkeep

# Defense in depth for generated reports, even if output location changes.
**/g-content-analysis-report.html
**/g-content-inventory.xlsx
**/g-content-analysis*.xlsx

# ------------------------------------------------------------
# Local release archives
# Keep source ZIPs outside the repository or publish binaries through
# GitHub Releases. Do not commit packaged Windows distributions.
# ------------------------------------------------------------
GFileStudio_v*_Windows_x64.zip

# ------------------------------------------------------------
# User-specific runtime configuration
# The default drawing_frame_config.json remains tracked.
# ------------------------------------------------------------
config/user_settings.json
config/recent_projects.json
config/session.json
config/app_state.json

# ------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.local.json
*.local.yaml
*.local.yml
